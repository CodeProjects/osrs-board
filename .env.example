# Base URL of the osrs-board-server API. Leave unset for local dev - Vite's
# dev server proxies relative /api/* requests to http://localhost:3001 (see
# vite.config.ts). Set this for production builds, where the client is
# hosted separately from the server, e.g.:
#   VITE_API_BASE_URL=https://osrs-board-server.example.com
VITE_API_BASE_URL=
